# Auto detect text files and perform LF normalization
* text=auto

# Ensure Python files use LF line endings
*.py text eol=lf
*.ipynb text eol=lf

# Ensure CSV files use LF line endings
*.csv text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary